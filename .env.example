# Neon Postgres pooled connection string (Neon -> Connect -> pooled URL).
DATABASE_URL="postgresql://user:pass@host/neondb?sslmode=require"

# Password gate for the dashboard. Leave blank to run open (not recommended).
DASHBOARD_PASSWORD=""

# Public URL of this app, used to render the install snippet in Settings.
NEXT_PUBLIC_APP_URL="https://pulse.ryderschilling.com"

# Google service account (GA4 Data API + Search Console). Paste the whole JSON
# on one line, OR set GOOGLE_SERVICE_ACCOUNT_FILE to a path for local dev.
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_SERVICE_ACCOUNT_FILE=""
